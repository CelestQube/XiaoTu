# Copy this file to .env. Keep secrets on this machine.
# Chat model: any OpenAI-compatible /chat/completions endpoint that supports JSON output.
# Example, Zhipu Coding Plan (thinking model; glm-5.3/5.3-flash cannot disable thinking):
#   XIAOTU_MODEL_API_KEY=<coding-plan key>
#   XIAOTU_MODEL=glm-5.3-flash
#   XIAOTU_MODEL_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
#   XIAOTU_MODEL_REASONING_EFFORT=high   # minimal/low/medium/high/xhigh/max; empty = not sent
XIAOTU_MODEL_API_KEY=
XIAOTU_MODEL=
XIAOTU_MODEL_BASE_URL=
XIAOTU_MODEL_REASONING_EFFORT=
# Legacy aliases, still honoured when the neutral names above are empty:
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
# Optional when your provider requires it for JSON mode: QWEN_ENABLE_THINKING=false
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Tencent Location Service Key with WebService API enabled. Server-side only.
TENCENT_MAP_API_KEY=
# Local railway MCP: manage it in config/mcp_settings.json. Legacy false still disables it.
RAIL_MCP_ENABLED=true
# Python backend listens on localhost. Keep the simulator off unless running the local experiment.
XIAOTU_PY_PORT=3212
XIAOTU_FOOD_DEMO=false
# Optional local HTTP test merchant (e.g. http://127.0.0.1:3221). Empty uses in-process simulation.
XIAOTU_FOOD_SANDBOX_URL=
# McDonald's MCP personal token from https://open.mcd.cn console. Orders run on that account.
MCD_MCP_TOKEN=
# Real order creation is opt-in: with a token, queries work but create-order needs true.
XIAOTU_MCD_ORDER=false
